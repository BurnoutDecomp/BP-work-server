# /etc/bp-work-server/bp-work-server.env: settings for the bp-work-server container.
# compose.yaml reads this file. It lives outside the repo, so deploys never touch it.
# Paths are host paths; /var/lib/bp-work-server is mounted at the same place.

# Databases
BP_WORK_DB=/var/lib/bp-work-server/bp-work.sqlite3
BP_WORK_USERS_DB=/var/lib/bp-work-server/bp-work-users.sqlite3

# GitHub dashboard panel
BP_GITHUB_OWNER=BurnoutDecomp
BP_GITHUB_REPO=b5-decomp
BP_GITHUB_REF=dev
# GITHUB_TOKEN=

# Workflow progress import
BP_WORKFLOW_REPO=https://github.com/BurnoutDecomp/BP-Decomp_Workflow.git
BP_WORKFLOW_ROOT=/var/lib/bp-work-server/BP-Decomp_Workflow
BP_WORKFLOW_BRANCH=main

# Build downloads: Drive assets (rclone) merged with each exe CI uploads
BP_ASSET_RCLONE_REMOTE=gdrive:
BP_ASSETS_DIR=/var/lib/bp-work-server/assets
RCLONE_CONFIG=/var/lib/bp-work-server/.config/rclone/rclone.conf
BP_DOWNLOADS_DIR=/var/lib/bp-work-server/downloads
BP_KEEP_BUILDS=5
BP_DOWNLOADS_ACCEL=/_dl/
